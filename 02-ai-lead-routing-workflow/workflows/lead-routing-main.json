        "chatId":"={{ $vars.LEAD_ALERT_CHAT_ID }}",
        "text":"={{ (() => { const d = $('Calculate Explainable Score').item.json; const leading = /^[ \\t\\u00A0\\u1680\\u2000-\\u200A\\u202F\\u205F\\u3000\\uFEFF\\u200B-\\u200D\\u2060]+/gmu; const clean = (v) => String(v ?? '').replace(/\\r\\n?/g, '\\n').replace(leading, '').trim(); const esc = (v) => clean(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const message = ['🔥 <b>HOT LEAD</b>', '', '👤 <b>Contact</b>', esc(d.name), esc(d.company || 'No company'), '', '📊 <b>Qualification</b>', `Score: ${esc(d.score)}/100`, `Service: ${esc(d.requested_service)}`, `Urgency: ${esc(d.urgency)}`, '', '💬 <b>Summary</b>', esc(d.summary), '', '🆔 <b>Request</b>', `<code>${esc(d.request_id)}</code>`].join('\\n'); return message.replace(leading, ''); })() }}",
        "additionalFields":{"appendAttribution":false,"parse_mode":"HTML"}

      "type":"@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion":1.3,
      "position":[-80,160],
      "id":"bc0215d9-d2b5-4af7-b98b-c06638bbf566",
      "name":"OpenAI Chat Model"
    },
    {
      "parameters": {
        "jsCode":"const lead = $('Normalize Lead Input').item.json;\nconst extracted = ($json && $json.output && typeof $json.output === 'object') ? $json.output : null;\nconst budgetFromNumber = lead.estimated_budget >= 20000 ? '20k_plus' : lead.estimated_budget >= 10000 ? '10k_20k' : lead.estimated_budget >= 5000 ? '5k_10k' : lead.estimated_budget > 0 ? 'under_5k' : null;\nconst budget = budgetFromNumber || extracted?.budget_category || 'unknown';\nconst budgetPoints = { '20k_plus': 30, '10k_20k': 24, '5k_10k': 16, 'under_5k': 6, unknown: 0 }[budget] ?? 0;\nconst urgency = extracted?.urgency || 'unclear';\nconst urgencyPoints = { immediate: 25, within_month: 20, this_quarter: 10, exploring: 2, unclear: 0 }[urgency] ?? 0;\nconst decisionMaker = extracted?.decision_maker_signal || 'unknown';\nconst decisionPoints = { strong: 20, medium: 10, weak: 3, unknown: 0 }[decisionMaker] ?? 0;\nconst service = extracted?.requested_service || 'unclear';\nconst coreServices = ['workflow_automation', 'ai_integration', 'crm_integration', 'data_pipeline'];\nconst servicePoints = coreServices.includes(service) ? 15 : 0;\nconst companyPoints = lead.company ? 5 : 0;\nconst messagePoints = lead.message.length >= 80 ? 5 : 0;\nconst score = budgetPoints + urgencyPoints + decisionPoints + servicePoints + companyPoints + messagePoints;\nconst confidence = Number(extracted?.confidence ?? 0);\nconst reviewReasons = [];\nif (!extracted) reviewReasons.push('ai_extraction_failed');\nif (confidence < 0.65) reviewReasons.push('low_confidence');\nif (service === 'unclear') reviewReasons.push('unclear_service');\nif (urgency === 'unclear') reviewReasons.push('unclear_timeline');\nconst tier = reviewReasons.length ? 'needs_review' : score >= 75 ? 'hot' : score >= 45 ? 'warm' : 'cold';\nreturn [{ json: { ...lead, intent: extracted?.intent || 'other', requested_service: service, urgency, budget_category: budget, decision_maker_signal: decisionMaker, summary: extracted?.summary || 'AI extraction failed; manual qualification required.', missing_information: extracted?.missing_information || ['requested_service','budget','timeline','business_goal'], confidence, score, tier, review_reasons: reviewReasons, score_breakdown: { budget: budgetPoints, urgency: urgencyPoints, decision_maker: decisionPoints, service_fit: servicePoints, company_supplied: companyPoints, message_quality: messagePoints }, scoring_version: '1.0.0' } }];"
      },

      "id": "5df1a9e8-6627-45b2-b085-e7ca56049224",
      "name": "AI Processing Error?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2304,
        528
      ]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'Invoice extraction failed: ' + ($json.error?.message ?? $json.error ?? ($json.status ? 'OpenAI response status: ' + $json.status : 'OpenAI returned no structured output.')) }}"
      },
      "id": "3719f338-a3ba-4730-980f-155c983d4650",
      "name": "Stop - AI Processing Failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        2544,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst source = $('Validate and Hash').item.json;\nconst outputText = response.output\n  ?.find((entry) => entry.type === 'message')\n  ?.content?.find((entry) => entry.type === 'output_text')?.text;\n\nconst invoice = typeof outputText === 'string'\n  ? JSON.parse(outputText)\n  : outputText;\n\nif (!invoice || typeof invoice !== 'object') {\n  throw new Error('OpenAI returned no structured invoice object.');\n}\n\nconst reasons = [];\nconst required = ['invoice_number','vendor_name','invoice_date','due_date','currency','subtotal','tax_amount','total_amount'];\nfor (const field of required) if (invoice[field] === null || invoice[field] === '') reasons.push(`missing:${field}`);\nfor (const field of invoice.missing_fields ?? []) if (!reasons.includes(`missing:${field}`)) reasons.push(`missing:${field}`);\nif (invoice.document_type !== 'invoice') reasons.push(`document_type:${invoice.document_type}`);\nif (invoice.confidence < 0.85) reasons.push(`low_confidence:${invoice.confidence}`);\nconst datePattern = /^\\d{4}-\\d{2}-\\d{2}$/;\nfor (const field of ['invoice_date','due_date']) if (invoice[field] !== null && !datePattern.test(invoice[field])) reasons.push(`invalid_date:${field}`);\nif (invoice.currency !== null && !/^[A-Z]{3}$/.test(invoice.currency)) reasons.push('invalid_currency');\nfor (const field of ['subtotal','tax_amount','total_amount']) if (invoice[field] !== null && (!Number.isFinite(invoice[field]) || invoice[field] < 0)) reasons.push(`invalid_amount:${field}`);\nif ([invoice.subtotal, invoice.tax_amount, invoice.total_amount].every((value) => typeof value === 'number')) {\n  const difference = Math.abs(invoice.subtotal + invoice.tax_amount - invoice.total_amount);\n  if (difference > 0.02) reasons.push(`totals_mismatch:${difference.toFixed(2)}`);\n}\nconst status = reasons.length === 0 ? 'processed' : 'needs_review';\nreturn [{ json: {\n  ...source,\n  openai_response_id: response.id ?? null,\n  model: response.model ?? 'gpt-4o-mini',\n  extraction: invoice,\n  processing_error: null,\n  ...invoice,\n  status,\n  review_reasons: reasons,\n  validated_at: new Date().toISOString(),\n} }];"
      },

              "id": "54c37a44-b607-404c-960d-processing-error",
              "leftValue": "={{ $json.error?.message ?? $json.error ?? ($json.status && $json.status !== 'completed' ? 'OpenAI response status: ' + $json.status : (!$json.output?.[0]?.content?.find(c => c.type === 'output_text')?.text ? 'OpenAI returned no structured output.' : '')) }}",

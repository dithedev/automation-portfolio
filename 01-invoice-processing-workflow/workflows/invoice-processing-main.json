      "id": "710c40f6-7ccc-46af-b86f-1f83412ebadc",
      "name": "Prepare Webhook Metadata",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        288,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst entries = Object.entries(item.binary ?? {});\nconst pdfs = entries.filter(([, file]) => file.mimeType === 'application/pdf' || String(file.fileName ?? '').toLowerCase().endsWith('.pdf'));\nif (pdfs.length !== 1) return [{ json: { source: 'gmail', valid: false, rejection_reason: `Expected exactly one PDF attachment, found ${pdfs.length}.`, email_id: item.json.id ?? null } }];\nconst [key, file] = pdfs[0];\nreturn [{ json: { source: 'gmail', request_id: $execution.id, received_at: new Date().toISOString(), email_id: item.json.id ?? null, original_binary_key: key }, binary: { data: file } }];"
      },
      "id": "815af041-a3d6-4bd7-a7b6-282400104f5c",
      "name": "Normalize Gmail Attachment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        704
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\n\nif (!item.binary?.data) {\n  return [{\n    json: {\n      ...item.json,\n      valid: false,\n      rejection_reason:\n        item.json.rejection_reason ?? 'No binary PDF data found.',\n    },\n  }];\n}\n\nconst file = item.binary.data;\nconst fileName = String(file.fileName ?? 'unknown');\nconst mimeType = String(file.mimeType ?? '').toLowerCase();\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\n\nconst maxBytes = 10 * 1024 * 1024;\n\nif (buffer.length === 0) {\n  return [{\n    json: {\n      ...item.json,\n      valid: false,\n      rejection_reason: 'The uploaded file is empty.',\n      file_name: fileName,\n    },\n  }];\n}\n\nif (buffer.length > maxBytes) {\n  return [{\n    json: {\n      ...item.json,\n      valid: false,\n      rejection_reason:\n        `File is too large (${buffer.length} bytes). Maximum is ${maxBytes} bytes.`,\n      file_name: fileName,\n    },\n  }];\n}\n\nconst hasPdfExtension = fileName.toLowerCase().endsWith('.pdf');\n\nconst allowedMimeTypes = new Set([\n  'application/pdf',\n  'application/x-pdf',\n  'application/octet-stream',\n  '',\n]);\n\nconst hasAllowedMimeType = allowedMimeTypes.has(mimeType);\n\n/*\n * According to the PDF specification, the PDF header should occur\n * within the first 1024 bytes. This detects files whose metadata claims\n * they are PDFs but whose actual contents are not.\n */\nconst headerRegion = buffer.subarray(0, Math.min(buffer.length, 1024));\nconst hasPdfSignature =\n  headerRegion.indexOf(Buffer.from('%PDF-', 'ascii')) !== -1;\n\nif (!hasPdfExtension) {\n  return [{\n    json: {\n      ...item.json,\n      valid: false,\n      rejection_reason:\n        `Unsupported file extension in \"${fileName}\". Only PDF is accepted.`,\n      file_name: fileName,\n      mime_type: mimeType || 'unknown',\n    },\n  }];\n}\n\nif (!hasAllowedMimeType) {\n  return [{\n    json: {\n      ...item.json,\n      valid: false,\n      rejection_reason:\n        `Unsupported file type: ${mimeType}. Only PDF is accepted.`,\n      file_name: fileName,\n      mime_type: mimeType,\n    },\n  }];\n}\n\nif (!hasPdfSignature) {\n  return [{\n    json: {\n      ...item.json,\n      valid: false,\n      rejection_reason:\n        'The uploaded file does not contain a valid PDF signature.',\n      file_name: fileName,\n      mime_type: mimeType || 'unknown',\n    },\n  }];\n}\n\nconst crypto = require('crypto');\n\nconst fileHash = crypto\n  .createHash('sha256')\n  .update(buffer)\n  .digest('hex');\n\nreturn [{\n  json: {\n    ...item.json,\n    valid: true,\n    file_name: fileName,\n    mime_type: 'application/pdf',\n    file_size_bytes: buffer.length,\n    file_hash: fileHash,\n  },\n  binary: item.binary,\n}];"
      },

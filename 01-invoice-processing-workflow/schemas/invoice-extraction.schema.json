{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/invoice-extraction.schema.json",
  "title": "InvoiceExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_type",
    "invoice_number",
    "vendor_name",
    "invoice_date",
    "due_date",
    "currency",
    "subtotal",
    "tax_amount",
    "total_amount",
    "confidence",
    "missing_fields",
    "notes"
  ],
  "properties": {
    "document_type": {
      "type": "string",
      "enum": ["invoice", "not_invoice", "uncertain"]
    },
    "invoice_number": {
      "type": ["string", "null"]
    },
    "vendor_name": {
      "type": ["string", "null"]
    },
    "invoice_date": {
      "type": ["string", "null"],
      "description": "ISO 8601 date (YYYY-MM-DD) or null"
    },
    "due_date": {
      "type": ["string", "null"],
      "description": "ISO 8601 date (YYYY-MM-DD) or null"
    },
    "currency": {
      "type": ["string", "null"],
      "description": "ISO 4217 currency code or null"
    },
    "subtotal": {
      "type": ["number", "null"]
    },
    "tax_amount": {
      "type": ["number", "null"]
    },
    "total_amount": {
      "type": ["number", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "invoice_number",
          "vendor_name",
          "invoice_date",
          "due_date",
          "currency",
          "subtotal",
          "tax_amount",
          "total_amount"
        ]
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

# Application
APP_NAME="Automated News Intelligence Pipeline"
APP_ENV=development
APP_MODE=demo
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
SCHEDULER_TIMEZONE=Europe/Vilnius

# PostgreSQL
POSTGRES_DB=news_pipeline
POSTGRES_USER=news_pipeline
POSTGRES_PASSWORD=change-me-in-local-env
DATABASE_URL=postgresql+asyncpg://news_pipeline:change-me-in-local-env@localhost:5432/news_pipeline

# OpenAI: required in live mode
# OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=2000

# Telegram: required for enabled live delivery
# TELEGRAM_BOT_TOKEN=replace-with-your-telegram-bot-token
# TELEGRAM_CHAT_ID=replace-with-your-telegram-chat-id
TELEGRAM_ENABLED=false
TELEGRAM_MAX_RETRIES=3
TELEGRAM_TIMEOUT_SECONDS=30

# News collection
FEEDS_CONFIG_PATH=config/feeds.yaml
TOPIC_PROFILE_PATH=config/topic_profile.yaml
FEED_FAILURE_WARNING_THRESHOLD=3
MAX_ARTICLES_PER_SOURCE=20
MAX_NEW_ITEMS_PER_RUN=100
ARTICLE_MAX_LENGTH=12000
FEED_RESPONSE_MAX_BYTES=2097152
FEED_FETCH_CONCURRENCY=3
MAX_ITEM_AGE_HOURS=72
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_TIMEOUT_SECONDS=15
HTTP_WRITE_TIMEOUT_SECONDS=5
HTTP_POOL_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=3
USER_AGENT="AutomatedNewsIntelligencePipeline/0.1 (+https://github.com/dithedev/automated-news-intelligence-pipeline)"

# Digest
MIN_DIGEST_ITEMS=3
MAX_DIGEST_ITEMS=7
MAX_LLM_CANDIDATES=25
DIGEST_TOP_ARTICLES=5
DIGEST_LANGUAGE=en
DIGEST_SCHEDULE_HOUR=8
DIGEST_SCHEDULE_MINUTE=0
SCHEDULER_ENABLED=false
SCHEDULER_MISFIRE_GRACE_SECONDS=300

# Security and operations
# Required for GET /status (header: X-Admin-Api-Key). Mandatory in production.
# ADMIN_API_KEY=replace-with-a-long-random-value
MANUAL_RUN_ENABLED=true
EXPOSE_DEMO_ENDPOINTS=false
LOG_PII=false